# Copy to .env and adjust for local / hosted demos
#
# JWT_SECRET and APPLE_VERIFY_TOKEN below are development values, and both fail open:
# they produce a server that looks healthy while accepting forged identities. The server
# refuses to start on them unless ALLOW_INSECURE_CONFIG is set, so a deployment that
# forgets to override them fails loudly instead of silently trusting anyone.
ALLOW_INSECURE_CONFIG=true

MONGODB_URI=mongodb://localhost:27017/kismet
JWT_SECRET=dev-only-change-me-use-at-least-32-chars!!
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
# Must match the iOS app's PRODUCT_BUNDLE_IDENTIFIER (Apple JWT aud claim)
APPLE_CLIENT_ID=bhanageviraj.Yuti
# false = decode identity token without JWKS (Simulator / local only). Prod must be true.
APPLE_VERIFY_TOKEN=false
PORT=8080
CORS_ORIGINS=*
