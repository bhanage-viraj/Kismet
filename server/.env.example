# Copy to .env and adjust for local / hosted demos
#
# JWT_SECRET and APPLE_VERIFY_TOKEN below are development values, and both fail open:
# they produce a server that looks healthy while accepting forged identities. The server
# refuses to start on them unless ALLOW_INSECURE_CONFIG is set, so a deployment that
# forgets to override them fails loudly instead of silently trusting anyone.
ALLOW_INSECURE_CONFIG=true
DEV_SEED_ENABLED=true

MONGODB_URI=mongodb://localhost:27017/kismet
JWT_SECRET=dev-only-change-me-use-at-least-32-chars!!
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
# Must match iOS PRODUCT_BUNDLE_IDENTIFIER values (Apple JWT aud). Comma-separate for both teams.
APPLE_CLIENT_ID=bhanageviraj.indeKismet,sanjivanand.IndeKismet
# false = decode identity token without JWKS (Simulator / local only). Prod must be true.
APPLE_VERIFY_TOKEN=false
PORT=8080
CORS_ORIGINS=*

# Silent push wake (optional). Without these, LOCATION blobs still relay + WebSocket notify,
# but backgrounded phones won't wake until a significant location change.
APNS_ENABLED=false
APNS_PRODUCTION=false
# Primary Apple team (your build)
APNS_KEY_ID=
APNS_TEAM_ID=JMN9RWVFLZ
APNS_BUNDLE_ID=bhanageviraj.indeKismet
APNS_KEY_PATH=
# Or paste the .p8 PEM inline (including BEGIN/END lines) via APNS_KEY_P8=
# Secondary Apple team (teammate build)
APNS_2_KEY_ID=
APNS_2_TEAM_ID=84Q3MJ58NW
APNS_2_BUNDLE_ID=sanjivanand.IndeKismet
APNS_2_KEY_PATH=
# Or APNS_2_KEY_P8=
